# 端口号
VITE_PORT=5666

VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 开发环境真实后端代理地址，填写完整 API 前缀，例如 https://your-domain.example.com/api
# 留空时，Vite 不会再把 /api 默认代理到本地 mock。
VITE_DEV_PROXY_TARGET=http://120.55.244.232/api

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=true

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
